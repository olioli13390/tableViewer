{% extends "../layout/base.twig" %}

{% block style %}
	<link rel="stylesheet" href="/assets/css/settings.css">
	<link rel="stylesheet" href="/assets/css/wizard.css">
{% endblock %}

{% block title %}
	<title>Wizard</title>
{% endblock %}

{% block main %}
	<form
		id="wizardForm" action="/visualization" method="POST">
		<!-- Étape 1 -->
		<div class="step.active" id="step1">
			<h2>Étape 1 : Choisissez le type de graphique</h2>
			<select name="chartType" required>
				<option value="bar">Barres</option>
				<option value="line">Lignes</option>
				<option value="pie">Camembert</option>
				<option value="doughnut">Donut</option>
			</select>
			<button type="button" onclick="nextStep()">Suivant</button>
		</div>

		<!-- Étape 2 : Labels -->
		<div class="step" id="step2" style="display:none">
			<h2>Étape 2 : Choisissez la colonne pour les labels</h2>
			{% for header in headers %}
				<label>
					<input type="radio" name="labelColumn" value="{{ header }}" required>
					{{ header }}
				</label><br>
			{% endfor %}
			<button type="button" onclick="prevStep()">Précédent</button>
			<button type="button" onclick="nextStep()">Suivant</button>
		</div>

		<!-- Étape 3 : Données -->
		<div class="step" id="step3" style="display:none">
			<h2>Étape 3 : Sélectionnez les colonnes de données à comparer</h2>
			{% for header in headers %}
				<label>
					<input type="checkbox" name="dataColumns" value="{{ header }}">
					{{ header }}
				</label><br>
			{% endfor %}
			<button type="button" onclick="prevStep()">Précédent</button>
			<button type="button" onclick="nextStep()">Suivant</button>
			<button type="submit">Visualiser</button>
		</div>
	</form>


	<script>

		let currentStep = 1;

function showStep(step) {
document.querySelectorAll(".step").forEach(div => div.style.display = "none");
document.getElementById("step" + step).style.display = "block";
currentStep = step;
}

function nextStep() {
if (currentStep < 5) 
showStep(currentStep + 1);


}

function prevStep() {
if (currentStep > 1) 
showStep(currentStep - 1);


}
	</script>
{% endblock %}
