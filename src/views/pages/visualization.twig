{% extends "../layout/base.twig" %}

{% block style %}
	<link rel="stylesheet" href="/assets/css/settings.css">
	<link rel="stylesheet" href="/assets/css/visualization.css">
{% endblock %}

{% block title %}
	<title>Visualization</title>
{% endblock %}

{% block main %}

	<div class="visualization-container">
		<h2>Visualization :
			{{ chartType|capitalize }}</h2>
		<canvas id="myChart" width="800" height="400" data-chart='{{ chartType }}' data-labels='{{ labels|json_encode|e('html_attr') }}' data-datasets='{{ datasets|json_encode|e('html_attr') }}'></canvas>
	</div>
{% endblock %}
{% block script %}

	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="/js/chartDisplay.js"></script>

{% endblock %}
